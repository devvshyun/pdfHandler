PORT=3000
# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pdfhandler
DB_PASSWORD=pdfhandler
DB_NAME=pdfhandler
# Run pending migrations on boot (true/false)
DB_MIGRATE_ON_BOOT=true
# Redis
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=300
# File storage (local disk)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=100
# Optional TTF/OTF used by server-side text operations (needed for Korean watermarks)
PDF_FONT_PATH=
# Serve the built frontend from this directory (leave empty to disable)
FRONTEND_DIST=../frontend/dist
# Prefix for every Redis key (optional)
REDIS_KEY_PREFIX=
# Uploads: per-file limit is MAX_UPLOAD_MB; files per request; whole request; temp dir (disk, not RAM)
MAX_MERGE_FILES=20
MAX_REQUEST_MB=200
UPLOAD_TMP_DIR=
# Accounts. AUTH_REQUIRED=false = single-tenant mode without login (local use only).
AUTH_REQUIRED=true
# Required when NODE_ENV=production. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_SECONDS=43200
# Cross-origin API access (comma separated, * = any). Empty = no CORS headers (same-origin only).
CORS_ORIGINS=
# Express trust proxy (e.g. 1 behind one reverse proxy) so rate limits see the client IP
TRUST_PROXY=false
# Rate limits as count/seconds (0 disables)
RATE_LIMIT_AUTH=20/60
RATE_LIMIT_LOGIN=10/900
RATE_LIMIT_TOOLS=30/60
RATE_LIMIT_DOCUMENTS=300/60
# PDF worker threads (0 = run on the request thread), queue length, per-task timeout
PDF_WORKERS=
PDF_QUEUE_MAX=16
PDF_TASK_TIMEOUT_MS=120000
